# --- connection ---------------------------------------------------
mpd_host = 192.168.0.121
mpd_port = 6600
mpd_connection_timeout = 5
mpd_music_dir = ""

# --- visualizer (fed locally by parec, see the 'music' launcher) ---
visualizer_data_source = /tmp/mpd.fifo
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_fps = 60
visualizer_autoscale = yes
visualizer_look = ●▮
visualizer_color = 33, 39, 45, 51, 50, 49, 48, 47
visualizer_spectrum_smooth_look = yes

# --- interface (Arc Dark-ish, to match the Kvantum theme) ---------
user_interface = alternative
playlist_display_mode = columns
song_columns_list_format = (6f)[blue]{l} (23)[cyan]{a} (40)[white]{t|f} (26)[magenta]{b}
progressbar_look = ─╼·
now_playing_prefix = "$b$5"
now_playing_suffix = "$/b$9"
main_window_color = white
header_window_color = cyan
volume_color = blue
progressbar_color = black
progressbar_elapsed_color = blue
statusbar_color = white
color1 = white
color2 = blue
media_library_primary_tag = album_artist
startup_screen = playlist
autocenter_mode = yes
centered_cursor = yes
cyclic_scrolling = yes
mouse_support = yes
display_bitrate = yes
display_remaining_time = yes
song_status_format = "{%a - }{%t}|{%f}"
